<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="T3 Presence" Width="500" Height="500" MinWidth="440" MinHeight="470"
        Background="Transparent" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#F2F3F5">
  <Window.Resources>
    <SolidColorBrush x:Key="Card" Color="#E62B2D31"/>
    <SolidColorBrush x:Key="Line" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Muted" Color="#B5BAC1"/>
    <SolidColorBrush x:Key="Dim" Color="#80848E"/>
    <SolidColorBrush x:Key="Accent" Color="#5865F2"/>
    <SolidColorBrush x:Key="Field" Color="#1E1F22"/>

    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/><Setter Property="Margin" Value="2,18,0,8"/>
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RowNote" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{StaticResource Dim}"/><Setter Property="Margin" Value="0,2,0,0"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16,4"/>
    </Style>
    <Style x:Key="RowGrid" TargetType="Grid"><Setter Property="Margin" Value="0,10"/><Setter Property="MinHeight" Value="24"/></Style>
    <Style x:Key="Sep" TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{StaticResource Line}"/></Style>

    <!-- Toggle switch -->
    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="Track" Width="38" Height="22" CornerRadius="11" Background="#4E5058">
          <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
            <Ellipse.RenderTransform><TranslateTransform x:Name="Tx" X="0"/></Ellipse.RenderTransform>
          </Ellipse>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Track" Property="Background" Value="#5865F2"/>
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Tx" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Tx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Tabs -->
    <Style x:Key="Tab" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="B" Background="Transparent" CornerRadius="7" Padding="16,6"><ContentPresenter HorizontalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#F2F3F5"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="#40FFFFFF"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Buttons -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="B" Background="#33FFFFFF" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#4DFFFFFF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#26FFFFFF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Setter Property="Padding" Value="14,7"/>
    </Style>
    <Style x:Key="Step" TargetType="Button" BasedOn="{StaticResource Btn}"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="15"/></Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="CaretBrush" Value="#F2F3F5"/>
      <Setter Property="SelectionBrush" Value="#5865F2"/><Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7" Padding="9,7" BorderThickness="1" BorderBrush="Transparent"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#5865F2"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- ComboBox -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="B" Background="{StaticResource Field}" CornerRadius="7">
          <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" Data="M0,0 L4.5,5 L9,0" Stroke="#B5BAC1" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#2A2B30"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="Width" Value="150"/><Setter Property="Height" Value="32"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
          <ContentPresenter IsHitTestVisible="False" Margin="11,0,26,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"/>
          <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4" Focusable="False">
            <Border Background="#111214" CornerRadius="8" Padding="4" MinWidth="150" BorderBrush="#26FFFFFF" BorderThickness="1"><ItemsPresenter/></Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#DBDEE1"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="B" CornerRadius="5" Padding="9,6" Background="Transparent"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="B" Property="Background" Value="#5865F2"/><Setter Property="Foreground" Value="White"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Thin scrollbar -->
    <Style x:Key="ThumbS" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="#40FFFFFF" CornerRadius="3" Width="6"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/><Setter Property="MinWidth" Value="10"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb Style="{StaticResource ThumbS}"/></Track.Thumb></Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root" Background="#59111214">
    <Grid Margin="22,14,22,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- Header -->
      <Grid>
        <Border Background="#26000000" CornerRadius="9" Padding="2" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><RadioButton x:Name="TabLive" Style="{StaticResource Tab}" Content="Presence" GroupName="Tabs" IsChecked="True"/><RadioButton x:Name="TabSet" Style="{StaticResource Tab}" Content="Settings" GroupName="Tabs" Margin="2,0,0,0"/></StackPanel></Border>
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="11" Background="#26FFFFFF" Padding="10,4">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="#80848E" VerticalAlignment="Center"/>
            <TextBlock x:Name="ConnText" Text="Starting" Margin="7,0,0,0" FontSize="12" Foreground="#DBDEE1"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Presence tab -->
      <Grid x:Name="LivePanel" Grid.Row="1" Margin="0,16,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Background="#F2232428" CornerRadius="14" Padding="20,18,20,20">
          <StackPanel>
            <TextBlock x:Name="HeadWord" Text="Watching" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid Width="104" Height="104" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Border x:Name="Cover" Width="96" Height="96" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#000000"/>
                <Border x:Name="Overlay" Width="30" Height="30" CornerRadius="15" Background="#232428" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,0">
                  <Ellipse x:Name="OverlayDot" Width="20" Height="20" Fill="#23A55A"/>
                </Border>
              </Grid>
              <StackPanel x:Name="Lines" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="T3 Code" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock x:Name="Details" Text=" " FontSize="14" Foreground="#DBDEE1" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="State" Text=" " FontSize="14" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="Elapsed" Text=" " FontSize="13" FontWeight="SemiBold" Foreground="#23A55A" Margin="0,7,0,0"/>
              </StackPanel>
            </Grid>
            <Border Style="{StaticResource Sep}" Margin="0,16,0,12"/>
            <StackPanel Orientation="Horizontal"><TextBlock Text="On image hover" FontSize="11.5" Foreground="{StaticResource Dim}"/><TextBlock x:Name="Hover" Text="" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="9,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="320"/></StackPanel>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="2,16,0,0">
          <TextBlock Text="ROTATION" Style="{StaticResource Section}" Margin="0,0,0,8"/>
          <WrapPanel x:Name="Chips"/>
          <TextBlock x:Name="Coverage" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="Reason" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>

        <Grid Grid.Row="3">
          <Button x:Name="PauseBtn" Style="{StaticResource Btn}" Content="Pause presence" HorizontalAlignment="Left"/>
          <TextBlock Text="Closing keeps it running in the tray" FontSize="11.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
      </Grid>

      <!-- Settings tab -->
      <ScrollViewer x:Name="SetPanel" Grid.Row="1" Margin="0,2,-10,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="0,0,14,6">
          <TextBlock Text="DISPLAY" Style="{StaticResource Section}"/>
          <Border Style="{StaticResource Panel}"><StackPanel>
            <Grid Style="{StaticResource RowGrid}"><TextBlock Text="Activity type" Style="{StaticResource RowLabel}"/><ComboBox x:Name="TypeBox" HorizontalAlignment="Right"><ComboBoxItem Content="Watching"/><ComboBoxItem Content="Playing"/><ComboBoxItem Content="Listening"/><ComboBoxItem Content="Competing"/></ComboBox></Grid>
            <Border Style="{StaticResource Sep}"/>
            <Grid Style="{StaticResource RowGrid}"><StackPanel HorizontalAlignment="Left" Margin="0,0,56,0"><TextBlock Text="Live line" Style="{StaticResource RowLabel}"/><TextBlock Text="What the agent is doing right now, by kind only: Editing a file, Running a command. Never paths or commands." Style="{StaticResource RowNote}"/></StackPanel><CheckBox x:Name="LiveT" Style="{StaticResource Toggle}" HorizontalAlignment="Right"/></Grid>
            <Border Style="{StaticResource Sep}"/>
            <Grid Style="{StaticResource RowGrid}"><TextBlock Text="Show project name" Style="{StaticResource RowLabel}"/><CheckBox x:Name="ProjT" Style="{StaticResource Toggle}" HorizontalAlignment="Right"/></Grid>
          </StackPanel></Border>

          <TextBlock Text="PAGES" Style="{StaticResource Section}"/>
          <Border Style="{StaticResource Panel}"><StackPanel>
            <Grid Style="{StaticResource RowGrid}"><StackPanel HorizontalAlignment="Left"><TextBlock Text="Activity" Style="{StaticResource RowLabel}"/><TextBlock Text="Project and live line" Style="{StaticResource RowNote}"/></StackPanel><CheckBox x:Name="PgActivity" Style="{StaticResource Toggle}" HorizontalAlignment="Right"/></Grid>
            <Border Style="{StaticResource Sep}"/>
            <Grid Style="{StaticResource RowGrid}"><StackPanel HorizontalAlignment="Left"><TextBlock Text="Agents" Style="{StaticResource RowLabel}"/><TextBlock Text="Running count, then each model and effort" Style="{StaticResource RowNote}"/></StackPanel><CheckBox x:Name="PgAgents" Style="{StaticResource Toggle}" HorizontalAlignment="Right"/></Grid>
            <Border Style="{StaticResource Sep}"/>
            <Grid Style="{StaticResource RowGrid}"><StackPanel HorizontalAlignment="Left"><TextBlock Text="Tokens" Style="{StaticResource RowLabel}"/><TextBlock Text="Input, output, cache read and write today" Style="{StaticResource RowNote}"/></StackPanel><CheckBox x:Name="PgTokens" Style="{StaticResource Toggle}" HorizontalAlignment="Right"/></Grid>
            <Border Style="{StaticResource Sep}"/>
            <Grid Style="{StaticResource RowGrid}"><StackPanel HorizontalAlignment="Left"><TextBlock Text="Token value" Style="{StaticResource RowLabel}"/><TextBlock Text="Dollar value at API list prices, not a bill" Style="{StaticResource RowNote}"/></StackPanel><CheckBox x:Name="PgValue" Style="{StaticResource Toggle}" HorizontalAlignment="Right"/></Grid>
            <Border Style="{StaticResource Sep}"/>
            <Grid Style="{StaticResource RowGrid}"><StackPanel HorizontalAlignment="Left"><TextBlock Text="Plan usage" Style="{StaticResource RowLabel}"/><TextBlock Text="5 hour and weekly limits" Style="{StaticResource RowNote}"/></StackPanel><CheckBox x:Name="PgUsage" Style="{StaticResource Toggle}" HorizontalAlignment="Right"/></Grid>
          </StackPanel></Border>

          <TextBlock Text="TIMING" Style="{StaticResource Section}"/>
          <Border Style="{StaticResource Panel}"><StackPanel>
            <Grid Style="{StaticResource RowGrid}"><StackPanel HorizontalAlignment="Left"><TextBlock Text="Seconds per page" Style="{StaticResource RowLabel}"/><TextBlock Text="15 is the floor, Discord's rate limit" Style="{StaticResource RowNote}"/></StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="SecDown" Style="{StaticResource Step}" Content="&#x2212;"/><TextBlock x:Name="SecVal" Width="40" TextAlignment="Center" VerticalAlignment="Center" FontSize="14"/><Button x:Name="SecUp" Style="{StaticResource Step}" Content="+"/></StackPanel></Grid>
            <Border Style="{StaticResource Sep}"/>
            <Grid Style="{StaticResource RowGrid}"><StackPanel HorizontalAlignment="Left"><TextBlock Text="Idle minutes" Style="{StaticResource RowLabel}"/><TextBlock Text="Clear presence after this long with no agents" Style="{StaticResource RowNote}"/></StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="IdleDown" Style="{StaticResource Step}" Content="&#x2212;"/><TextBlock x:Name="IdleVal" Width="40" TextAlignment="Center" VerticalAlignment="Center" FontSize="14"/><Button x:Name="IdleUp" Style="{StaticResource Step}" Content="+"/></StackPanel></Grid>
          </StackPanel></Border>

          <TextBlock Text="COVER IMAGE" Style="{StaticResource Section}"/>
          <Border Style="{StaticResource Panel}"><StackPanel Margin="0,10">
            <TextBlock x:Name="CoverLabel" Text="Default cover" Style="{StaticResource RowLabel}"/>
            <TextBox x:Name="CoverBox" Margin="0,8,0,0"/>
            <TextBlock Text="Public https image URL or a Discord art asset name. Empty uses the T3 logo. Applies to the project shown here." Style="{StaticResource RowNote}" Margin="0,7,0,0"/>
            <Button x:Name="OpenCfg" Style="{StaticResource Btn}" Content="Open config.json" HorizontalAlignment="Left" Margin="0,10,0,0"/>
          </StackPanel></Border>

          <TextBlock Text="APP" Style="{StaticResource Section}"/>
          <Border Style="{StaticResource Panel}"><StackPanel>
            <Grid Style="{StaticResource RowGrid}"><TextBlock Text="Start with Windows" Style="{StaticResource RowLabel}"/><CheckBox x:Name="AutoT" Style="{StaticResource Toggle}" HorizontalAlignment="Right"/></Grid>
            <StackPanel x:Name="RemoteRow"><Border Style="{StaticResource Sep}"/>
            <Grid Style="{StaticResource RowGrid}"><StackPanel HorizontalAlignment="Left" Margin="0,0,56,0"><TextBlock Text="All environments" Style="{StaticResource RowLabel}"/><TextBlock Text="Add linked machines to agents, tokens and value. Off counts this PC only." Style="{StaticResource RowNote}"/></StackPanel><CheckBox x:Name="RemoteT" Style="{StaticResource Toggle}" HorizontalAlignment="Right"/></Grid></StackPanel>
          </StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
